<button class="to-top" id="toTop" type="button" title="回到顶部">↑</button>

<footer>
  <strong>永州爱眼城新员工8周成才培训体系 · V1.0版本</strong> &nbsp;|&nbsp; 全套课程 · 共56天 · 108个学习文件
</footer>

<script>
(function(){
  var KEY='eye8w_progress_v1', OPEN_KEY='eye8w_open_v1';
  var visited={};
  try{ visited=JSON.parse(localStorage.getItem(KEY)||'{}'); }catch(e){ visited={}; }
  var openWeeks=null;
  try{ openWeeks=JSON.parse(localStorage.getItem(OPEN_KEY)||'null'); }catch(e){ openWeeks=null; }

  var blocks=[].slice.call(document.querySelectorAll('.week-block'));
  var searchInput=document.getElementById('searchInput');
  var hideDone=document.getElementById('hideDone');
  var noResult=document.getElementById('noResult');

  /* ── 周进度标签 ── */
  blocks.forEach(function(b){
    var span=document.createElement('span');
    span.className='week-prog';
    b.querySelector('.week-header-btn').insertBefore(span, b.querySelector('.week-chevron'));
  });

  function dayDone(col){
    return [].slice.call(col.querySelectorAll('.day-link')).some(function(a){
      return !!visited[a.getAttribute('href')];
    });
  }

  function refresh(){
    blocks.forEach(function(b,i){
      var cols=[].slice.call(b.querySelectorAll('.day-col'));
      var d=0;
      cols.forEach(function(col){
        var ok=dayDone(col);
        col.classList.toggle('done', ok);
        col.querySelectorAll('.day-link').forEach(function(a){
          a.classList.toggle('visited', !!visited[a.getAttribute('href')]);
        });
        if(ok) d++;
      });
      b.querySelector('.week-prog').textContent=d+'/'+cols.length+' 天';
    });
    applyFilters();
  }

  function applyFilters(){
    var kw=(searchInput.value||'').trim().toLowerCase();
    var hide=hideDone.checked;
    var any=false;
    blocks.forEach(function(b){
      var shown=0;
      [].slice.call(b.querySelectorAll('.day-col')).forEach(function(col){
        var txt=(col.textContent||'').toLowerCase();
        var ok=(!kw||txt.indexOf(kw)>-1) && !(hide&&col.classList.contains('done'));
        col.classList.toggle('hide', !ok);
        if(ok) shown++;
      });
      b.style.display=shown?'':'none';
      if(shown) any=true;
      if(kw) b.classList.add('open');
    });
    noResult.classList.toggle('show', !any);
  }

  function saveOpen(){
    var st={};
    blocks.forEach(function(b){ st[b.id]=b.classList.contains('open'); });
    try{ localStorage.setItem(OPEN_KEY, JSON.stringify(st)); }catch(e){}
  }

  /* ── 事件 ── */
  document.querySelectorAll('.day-link').forEach(function(a){
    a.addEventListener('click', function(){
      visited[a.getAttribute('href')]=1;
      try{ localStorage.setItem(KEY, JSON.stringify(visited)); }catch(e){}
      refresh();
    });
  });

  window.toggleWeek=function(id){
    document.getElementById(id).classList.toggle('open');
    saveOpen();
  };
  document.getElementById('expandAll').onclick=function(){
    blocks.forEach(function(b){ b.classList.add('open'); }); saveOpen(); applyFilters();
  };
  document.getElementById('collapseAll').onclick=function(){
    blocks.forEach(function(b){ b.classList.remove('open'); }); saveOpen();
  };
  searchInput.addEventListener('input', applyFilters);
  hideDone.addEventListener('change', applyFilters);
  document.getElementById('resetBtn').onclick=function(){
    if(!confirm('确定要清空本机学习进度记录吗？')) return;
    visited={}; try{ localStorage.removeItem(KEY); }catch(e){}
    refresh();
  };

  var toTop=document.getElementById('toTop');
  window.addEventListener('scroll', function(){
    toTop.classList.toggle('show', window.scrollY>420);
  });
  toTop.onclick=function(){ window.scrollTo({top:0,behavior:'smooth'}); };

  /* ── 初始状态 ── */
  if(openWeeks){ blocks.forEach(function(b){ if(openWeeks[b.id]) b.classList.add('open'); }); }
  else { document.getElementById('w1').classList.add('open'); }
  refresh();
})();
</script>
</body>
</html>
