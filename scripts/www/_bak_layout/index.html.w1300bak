  <!-- ══════ 第2周 ══════ -->
  <div class="week-block w2" id="w2">
    <button class="week-header-btn" onclick="toggleWeek('w2')">
      <div class="week-header-left">
        <span class="week-num-badge">WEEK 02</span>
        <div>
          <div class="week-title">🔬 光学与产品知识</div>
          <div class="week-days-info">Day 08–14 · 眼睛结构、镜架镜片、处方解读、品牌陈列</div>
        </div>
      </div>
      <span class="week-chevron">▼</span>
    </button>
    <div class="week-body">
      <div class="days-grid">
        <div class="day-col">
          <div class="day-num">Day 08</div>
          <div class="day-topic">眼睛的结构与视觉原理</div>
          <div class="day-links">
