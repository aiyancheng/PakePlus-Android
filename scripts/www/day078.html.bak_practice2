            <script>
        // 选择题数据
        const choiceQuestions = [{
                type: 'single',
                options: [
                    { text: 'A. ‑5.00D（直接用验光度数）', correct: false },
                    , correct: true },
                    { text: 'B. ‑4.50D（减0.50D）', correct: false },
                    , correct: false },
                    { text: 'C. ‑4.00D（减1.00D）', correct: false },
                    , correct: false },
                    { text: 'D. ‑3.50D（减1.50D）', correct: false }
                ],
                answer: [1],  // -5.00 + 0.50 = -4.50 或 -5.00 + 1.00 = -4.00，选B最接近
                score: 10,
                explanation: '原则：泳镜度数 = 验光度数 - 0.50~1.00D。-5.00D应选-4.50D或-4.00D，选项中-4.50D最合适。'
            },
            
{
                type: 'single',
                options: [
                    { text: 'A. 用唾液涂抹镜片内侧', correct: false },
                    , correct: true },
                    { text: 'B. 用防雾剂涂抹后冲洗', correct: false },
                    , correct: false },
                    { text: 'C. 用毛巾用力擦拭镜片', correct: false },
                    , correct: false },
                    { text: 'D. 用热水冲洗镜片', correct: false }
                ],
                answer: [1],
                score: 10,
                explanation: '正确处理：用防雾剂涂抹→静置30秒→清水冲掉浮液→保留吸附层。A（唾液）含细菌损伤涂层，C（擦拭）破坏涂层，D（热水）加速涂层脱落。'
            },
            
{
                type: 'multi',
                options: [
                    { text: 'A. 近视>‑8.00D', correct: true },
                    , correct: true },
                    { text: 'B. 散光>‑2.00D', correct: false },
                    , correct: false },
                    { text: 'C. 轻度近视‑1.00D', correct: false },
                    , correct: false },
                    { text: 'D. 老花+2.00D', correct: false }
                ],
                answer: [0, 1],
                score: 10,
                explanation: '高度数（>‑8.00D）或高散光（>‑2.00D）时，定制光学泳镜效果差且昂贵，隐形+平光方案更优。轻度近视无需 special 方案，老花不影响游泳（看远为主）。'
            }
        
    ];

        // 初始化选择题
        function initChoiceQuestions() {
            const containers = document.querySelectorAll('.choice-question');
            containers.forEach((container, idx) => {
                const q = choiceQuestions[idx];
                if (!q) return;
                
                const optionsList = container.querySelector('.options-list');
                optionsList.innerHTML = '';
                
                q.options.forEach((opt, optIdx) => {
                    const li = document.createElement('li');
                    li.className = 'option-item';
                    li.textContent = opt.text;
                    li.setAttribute('data-index', optIdx);
                    li.onclick = () => toggleOption(li, idx, optIdx);
                    optionsList.appendChild(li);
                });
            });
        }

        // 切换选项
        function toggleOption(li, qIdx, optIdx) {
            const container = li.parentElement.parentElement;
            const q = choiceQuestions[qIdx];
            
            if (q.type === 'single') {
                container.querySelectorAll('.option-item').forEach(el => el.classList.remove('selected'));
                li.classList.add('selected');
            } else {
                li.classList.toggle('selected');
            }
        }

        // 获取选中的索引
        function getSelectedIndices(container) {
            return Array.from(container.querySelectorAll('.option-item.selected'))
                .map(el => parseInt(el.getAttribute('data-index')))
                .sort();
        }

        // 提交判分
        function submitAll() {
            let totalScore = 0;
            const containers = document.querySelectorAll('.choice-question');
            
            containers.forEach((container, idx) => {
                const q = choiceQuestions[idx];
                if (!q) return;
                
                const selected = getSelectedIndices(container);
                const correct = [...q.answer].sort();
                const feedback = container.querySelector('.feedback');
                
                if (JSON.stringify(selected) === JSON.stringify(correct)) {
                    feedback.innerHTML = '<div class="feedback-correct">回答正确！得分 +' + q.score + '分</div>';
                    totalScore += q.score;
                } else {
                    const correctText = q.answer.map(i => q.options[i].text).join('、');
                    feedback.innerHTML = `<div class="feedback-wrong">回答错误。正确答案：${correctText}<br>解析：${q.explanation}</div>`;
                }
            });
            
            const totalScoreElement = document.getElementById('scoreDisplay');
            if (totalScoreElement) {
                totalScoreElement.innerHTML = `<h3>总分：${totalScore} / 30 分</h3><p>选择题正确率：${totalScore / 30 * 100}%</p>`;
            }
        }

        // ========== 问答题：显示参考答案 ==========
        function showReference(btnId, answerId) {
            const answerDiv = document.getElementById(answerId);
            const btn = document.getElementById(btnId);
            if (answerDiv.classList.contains('show')) {
                answerDiv.classList.remove('show');
                btn.textContent = '📖 查看参考答案';
            } else {
                answerDiv.classList.add('show');
                btn.textContent = '🙈 隐藏参考答案';
            }
        }

        // 页面加载时初始化
        document.addEventListener('DOMContentLoaded', () => { initChoiceQuestions(); });
    </script>
