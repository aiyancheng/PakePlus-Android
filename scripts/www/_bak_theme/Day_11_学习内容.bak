  .lm-ref{background:#e3f2fd;color:#0d3c61}
  .lm-ref h3{color:#1565c0}
  .lm-quiz{background:#fce4ec;color:#880e4f}
  .lm-quiz h3{color:#c2185b}
  .lm-review{background:#ede7f6;color:#311b92}
